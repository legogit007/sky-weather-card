#!/bin/sh
# Blocks commits that add secrets or personal details.
# Generic patterns live here; personal words (names, suburbs, emails, hostnames) go in
# .git/info/sensitive-words, one per line. That file is local only and never committed.

# The hook's own pattern list is excluded so it doesn't flag itself
added=$(git diff --cached -U0 --no-color -- . ':(exclude).githooks' | grep '^+' | grep -v '^+++')
[ -z "$added" ] && exit 0

fail=0
check() { # $1 = label, $2 = extended regex
  hits=$(printf '%s\n' "$added" | grep -inE -e "$2")
  if [ -n "$hits" ]; then
    echo "pre-commit: possible $1:" >&2
    printf '%s\n' "$hits" | head -5 | sed 's/^/    /' >&2
    fail=1
  fi
}

check "private network address" '(^|[^0-9])(10\.[0-9]{1,3}|192\.168|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9]{1,3}(\.[0-9]{1,3})?'
check "email address" '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
check "access token or key" '(ghp_|gho_|ghs_|github_pat_|xox[bap]-|sk-[A-Za-z0-9]{20}|AKIA[0-9A-Z]{16}|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,})'
check "credential assignment" '(password|passwd|secret|api[_-]?key|token|bearer)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_\-]{8,}'
check "precise coordinates" '(-?[0-9]{1,3}\.[0-9]{5,})[[:space:]]*,[[:space:]]*(-?[0-9]{1,3}\.[0-9]{5,})'

words="$(git rev-parse --git-dir)/info/sensitive-words"
if [ -f "$words" ]; then
  hits=$(printf '%s\n' "$added" | grep -iF -f "$words")
  if [ -n "$hits" ]; then
    echo "pre-commit: matches a word in .git/info/sensitive-words:" >&2
    printf '%s\n' "$hits" | head -5 | sed 's/^/    /' >&2
    fail=1
  fi
fi

# Allowed: GitHub no-reply addresses and the Co-Authored-By trailer
if [ $fail -ne 0 ]; then
  echo "Commit blocked. Remove the lines above, or if they are safe, commit with --no-verify." >&2
  exit 1
fi
exit 0
